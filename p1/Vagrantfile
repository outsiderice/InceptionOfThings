# Vagrantfile
#

ENV["LC_ALL"] = "en_US.UTF-8"

Vagrant.require_version ">= 2.4"

Vagrant.configure("2") do |config|

  #### Common configuration.

  # Automated Machine Image
  #
  config.vm.box = "cloud-image/debian-13"
  config.vm.box_version = "20260722.2547.0"
  # config.vm.box_url = ""
  
  # Network
  #
  config.vm.network "forwarded_port", guest: 22, host: 50022, id: "ssh", auto_correct: true
  
  # Synced folder
  #
  config.vm.synced_folder ".", "/vagrant", disabled: true

  # cloud-init
  #
  config.vm.cloud_init do |cloud_init|
    cloud_init.content_type = "text/cloud-config"
    cloud_init.inline = <<-EOF
      timezone: Europe/Madrid
    EOF
  end

  # For libvirt provider
  #
  #config.vagrant.plugins = "vagrant-libvirt"
  config.vm.provider :libvirt do |libvirt|
    libvirt.driver = "kvm"
    libvirt.uri = "qemu:///session"
    libvirt.memory = 512
    libvirt.cpus = 1
  end

  # For QEMU provider (e.g. Apple Silicon)
  #
  config.vagrant.plugins = "vagrant-qemu"
  config.vm.provider :qemu do |qemu|
    qemu.machine = "virt,accel=hvf,highmem=off"
    qemu.smp = "1"
    qemu.memory = "512M"
    qemu.ssh_auto_correct = true
  end

  #### Machine (or node) specific configuration.

  # Controller node
  #
  config.vm.define "#{ENV['USER']}S", primary: true do |c|
    c.vm.hostname = "#{ENV['USER']}S"
    c.vm.network "private_network", ip: "192.168.56.110"
    c.vm.cloud_init do |cloud_init|
      cloud_init.content_type = "text/cloud-config"
      cloud_init.inline = <<-EOF
        package_update: true
      EOF
    end
  end

  # Worker node(s)
  #
  config.vm.define "#{ENV['USER']}SW" do |c|
    c.vm.hostname = "#{ENV['USER']}SW"
    c.vm.network "private_network", ip: "192.168.56.111"
    c.vm.cloud_init do |cloud_init|
      cloud_init.content_type = "text/cloud-config"
      cloud_init.inline = <<-EOF
        package_update: true
        packages:
          - tree
      EOF
    end
  end

end
